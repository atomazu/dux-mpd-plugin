{
  "id": "mpdControl",
  "name": "MPD Control",
  "description": "MPD playback status, track metadata, album art, and everyday transport controls",
  "version": "0.2.0",
  "author": "atomazu",
  "type": "composite",
  "capabilities": [
    "daemon",
    "dankbar-widget",
    "control-center"
  ],
  "components": {
    "daemon": "./Daemon.qml",
    "widget": "./Widget.qml"
  },
  "settings": "./Settings.qml",
  "icon": "music_note",
  "requires_dms": ">=2.0.0",
  "requires": [
    "python3"
  ],
  "permissions": [
    "settings_read",
    "settings_write"
  ]
}
